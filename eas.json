{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://puzzlepause.app/api",
                "EXPO_PUBLIC_APP_ENV": "development"
            }
        },
        "preview": {
            "environment": "preview",
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://puzzlepause.app/api",
                "EXPO_PUBLIC_APP_ENV": "preview"
            }
        },
        "production": {
            "environment": "production",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://puzzlepause.app/api",
                "EXPO_PUBLIC_APP_ENV": "production"
            }
        }
    },
    "submit": {
        "production": {}
    }
}

From 90940e002856b5a5dd4ee52450af39bf3da343c5 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 19 Aug 2026 16:26:02 +0000
Subject: [PATCH] Fix ConnectionsPuzzle crash when hint reveals more groups
 than initialized

The group count was derived from the number of revealed category hints,
which starts at 0 and grows incrementally. Once hints exceeded the
initial default of 3 groups, rendering accessed groups[i].size on
undefined Sets and crashed.

Use a stable getGroupCount helper (matching the mobile app) based on
puzzle.total_hints, categories, or prompt parsing. Sync the groups
state when the count changes and guard size reads defensively.
---
 .../puzzle-types/ConnectionsPuzzle.tsx        | 30 +++++++++++++++----
 .../__tests__/ConnectionsPuzzle.test.tsx      | 29 +++++++++++++++++-
 2 files changed, 53 insertions(+), 6 deletions(-)

diff --git a/web/components/puzzle-types/ConnectionsPuzzle.tsx b/web/components/puzzle-types/ConnectionsPuzzle.tsx
index f0008eb..db4358e 100644
--- a/web/components/puzzle-types/ConnectionsPuzzle.tsx
+++ b/web/components/puzzle-types/ConnectionsPuzzle.tsx
@@ -1,6 +1,6 @@
 'use client';
 
-import { useState } from 'react';
+import { useEffect, useState } from 'react';
 import { Puzzle } from '@/lib/api';
 import { parseQuestion } from './parseQuestion';
 
@@ -29,14 +29,22 @@ export default function ConnectionsPuzzle({
     hintsRevealed,
 }: Props) {
     const data = parseQuestion<ConnectionsData>(puzzle.question);
-    const allCategories = hint ? hint.split('|') : (data?.categories ?? []);
-    const numGroups = allCategories.length || 3;
+    const revealedCategories = hint ? hint.split('|') : (data?.categories ?? []);
+    const numGroups = data ? getGroupCount(data, puzzle.total_hints) : 3;
     // groups[categoryIdx] = Set of item indices
     const [groups, setGroups] = useState<Set<number>[]>(() =>
         Array.from({ length: numGroups }, () => new Set<number>())
     );
     const [selectedCategory, setSelectedCategory] = useState<number>(0);
 
+    useEffect(() => {
+        setGroups((prev) => {
+            if (prev.length === numGroups) return prev;
+            return Array.from({ length: numGroups }, (_, index) => prev[index] ?? new Set<number>());
+        });
+        setSelectedCategory((prev) => Math.min(prev, Math.max(numGroups - 1, 0)));
+    }, [numGroups]);
+
     function toggleItem(itemIdx: number) {
         if (solved) return;
         setGroups((prev) => {
@@ -87,7 +95,7 @@ export default function ConnectionsPuzzle({
                 {Array.from({ length: numGroups }, (_, i) => {
                     const label =
                         i < hintsRevealed
-                            ? (allCategories[i] ?? `Group ${i + 1}`)
+                            ? (revealedCategories[i] ?? `Group ${i + 1}`)
                             : `Group ${i + 1}`;
                     return (
                         <button
@@ -104,7 +112,7 @@ export default function ConnectionsPuzzle({
                                 borderRadius: 6,
                             }}
                         >
-                            {label} ({groups[i].size})
+                            {label} ({groups[i]?.size ?? 0})
                         </button>
                     );
                 })}
@@ -159,3 +167,15 @@ export default function ConnectionsPuzzle({
         </>
     );
 }
+
+function getGroupCount(data: ConnectionsData, totalHints: number): number {
+    const categoryCount = data.categories?.length;
+    if (categoryCount && categoryCount >= 2) return categoryCount;
+    if (totalHints >= 2 && data.items.length % totalHints === 0) return totalHints;
+    const promptCategoryCount = data.prompt.match(/\b(\d+)\s+categor(?:y|ies)\b/i);
+    if (promptCategoryCount?.[1]) {
+        const parsedCount = Number(promptCategoryCount[1]);
+        if (parsedCount >= 2 && data.items.length % parsedCount === 0) return parsedCount;
+    }
+    return 3;
+}
diff --git a/web/components/puzzle-types/__tests__/ConnectionsPuzzle.test.tsx b/web/components/puzzle-types/__tests__/ConnectionsPuzzle.test.tsx
index e0c7989..3cf72db 100644
--- a/web/components/puzzle-types/__tests__/ConnectionsPuzzle.test.tsx
+++ b/web/components/puzzle-types/__tests__/ConnectionsPuzzle.test.tsx
@@ -12,7 +12,7 @@ const QUESTION = JSON.stringify({
     categories: ['Snakes', 'Languages'],
 });
 
-function makePuzzle(question = QUESTION): Puzzle {
+function makePuzzle(question = QUESTION, overrides: Partial<Puzzle> = {}): Puzzle {
     return {
         id: 1,
         puzzle_date: '2026-01-01',
@@ -21,7 +21,9 @@ function makePuzzle(question = QUESTION): Puzzle {
         question,
         hint: null,
         has_hint: true,
+        total_hints: 2,
         puzzle_number: 1,
+        ...overrides,
     };
 }
 
@@ -75,6 +77,31 @@ describe('group labels', () => {
         expect(screen.queryByText(/Group 1/)).not.toBeInTheDocument();
         expect(screen.queryByText(/Group 2/)).not.toBeInTheDocument();
     });
+
+    it('keeps all group buttons when only one category hint is revealed', () => {
+        const unsolvedQuestion = JSON.stringify({
+            prompt: 'Group these 12 words into 4 categories of 3:',
+            items: Array.from({ length: 12 }, (_, index) => `Item ${index + 1}`),
+        });
+
+        render(
+            <ConnectionsPuzzle
+                puzzle={makePuzzle(unsolvedQuestion, { total_hints: 4 })}
+                solved={false}
+                onSubmit={() => {}}
+                loading={false}
+                hint="Category A"
+                hintsRevealed={1}
+            />
+        );
+
+        expect(screen.getByText(/Category A/)).toBeInTheDocument();
+        expect(screen.getByText(/Group 2/)).toBeInTheDocument();
+        expect(screen.getByText(/Group 3/)).toBeInTheDocument();
+        expect(screen.getByText(/Group 4/)).toBeInTheDocument();
+        expect(screen.getByText(/Category A \(0\)/)).toBeInTheDocument();
+        expect(screen.getByText(/Group 4 \(0\)/)).toBeInTheDocument();
+    });
 });
 
 describe('items', () => {
